# PostgreSQL (o docker-compose.yml da raiz sobe um com estas credenciais)
DATABASE_URL=postgresql://educarize:educarize@localhost:5432/educarize
JWT_SECRET=uma-chave-bem-segura
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Sessão (cookies httpOnly) ---
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# Em produção (NODE_ENV=production) os cookies já são "secure". Use COOKIE_SAMESITE=none apenas se
# frontend e API estiverem em sites diferentes (exige HTTPS).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# --- E-mail (recuperação de senha e verificação) ---
# Sem SMTP_HOST, os e-mails são exibidos no console do backend.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Educarize <no-reply@exemplo.com>
# Grava cada e-mail como JSON nesta pasta (útil em desenvolvimento).
# MAIL_OUTBOX_DIR=./outbox
# Exigir e-mail confirmado para fazer login.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Redis (opcional) ---
# Com Redis, o rate limit e o Socket.io passam a ser compartilhados entre várias instâncias do backend.
# Sem ele, tudo fica em memória (suficiente para uma instância).
# REDIS_URL=redis://localhost:6379

# --- Arquivos (capas, anexos e certificados) ---
# Padrão do projeto: o Silo do docker-compose.yml (storage S3; console em http://localhost:9001).
# O bucket é criado na primeira execução. Para guardar em disco, comente as linhas S3_* abaixo.
S3_BUCKET=educarize
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=educarize
S3_SECRET_ACCESS_KEY=educarize-silo
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
# Sem S3_BUCKET, os arquivos ficam em disco nesta pasta (suficiente para uma instância).
# UPLOAD_DIR=uploads
# Endereço público da API usado nos links dos arquivos (padrão: o host da requisição).
# Defina em produção atrás de proxy/HTTPS, ex.: https://api.exemplo.com
# PUBLIC_API_URL=
# Em produção, aponte para o seu storage S3 (AWS S3, Silo/MinIO, Cloudflare R2...), crie o bucket antes
# e deixe S3_CREATE_BUCKET desligado. Sem S3_ENDPOINT, usa a AWS na região abaixo.
# S3_REGION=us-east-1
# Silo/MinIO e alguns provedores exigem endereços no formato http://host/bucket (S3_FORCE_PATH_STYLE=true).
# Limpeza de arquivos sem uso: a cada N horas (0 desativa) remove os enviados há mais de M horas
# que não estão em nenhum material nem capa. Manual: npm run cleanup-files -- [horas]
# FILE_CLEANUP_INTERVAL_HOURS=6
# FILE_CLEANUP_GRACE_HOURS=24

# --- Outros ---
# Pasta antiga dos certificados (apenas leitura dos PDFs emitidos antes do storage).
# CERTIFICATES_DIR=certificates
# AUTH_RATE_LIMIT_MAX=20
