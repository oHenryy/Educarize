# PostgreSQL (o docker-compose.yml da raiz sobe um com estas credenciais)
DATABASE_URL=postgresql://educarize:educarize@localhost:5432/educarize
JWT_SECRET=uma-chave-bem-segura
PORT=4000
FRONTEND_URL=http://localhost:5173

# --- Sessão (cookies httpOnly) ---
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# Em produção (NODE_ENV=production) os cookies já são "secure". Use COOKIE_SAMESITE=none apenas se
# frontend e API estiverem em sites diferentes (exige HTTPS).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# --- E-mail (recuperação de senha e verificação) ---
# Sem SMTP_HOST, os e-mails são exibidos no console do backend.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Educarize <no-reply@exemplo.com>
# Grava cada e-mail como JSON nesta pasta (útil em desenvolvimento).
# MAIL_OUTBOX_DIR=./outbox
# Exigir e-mail confirmado para fazer login.
# REQUIRE_EMAIL_VERIFICATION=false

# --- Redis (opcional) ---
# Com Redis, o rate limit e o Socket.io passam a ser compartilhados entre várias instâncias do backend.
# Sem ele, tudo fica em memória (suficiente para uma instância).
# REDIS_URL=redis://localhost:6379

# --- Outros ---
# CERTIFICATES_DIR=certificates
# AUTH_RATE_LIMIT_MAX=20
